{
  "name": "mealmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync": "gulp sync",
    "build": "next build",
    "preview": "npm run clean && NEXT_PUBLIC_BASE_PATH=/MealMap NEXT_PUBLIC_API_BASE=/MealMap/api next build && node scripts/bundle.mjs --with-config --base=/MealMap",
    "watch": "gulp watch",
    "bundle": "npm run clean && NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_API_BASE=/api next build && node scripts/bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/build-icons.mjs",
    "db:migrate": "sh scripts/php.sh api/migrate.php",
    "db:seed": "sh scripts/php.sh api/seed.php",
    "db:reindex": "sh scripts/php.sh api/reindex.php",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "browser-sync": "^3.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "gulp": "^5.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
