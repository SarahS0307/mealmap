# Vorlage für die lokale .env – kopieren mit: cp .env.example .env
# Die echte .env wird nicht eingecheckt.

# Datenbank. Lokal eine SQLite-Datei im prisma-Ordner.
# Für den späteren Livegang hier eine Postgres-URL eintragen.
DATABASE_URL="file:./dev.db"

# Optional: Ports für die Entwicklung.
# NEXT_PORT=3000   # Next.js
# SYNC_PORT=3001   # BrowserSync-Proxy (npm run sync)
