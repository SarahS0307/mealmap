# Vorlage für die lokale .env – kopieren mit: cp .env.example .env
#
# In der Regel wird keine eigene .env gebraucht: Die Werte für die beiden
# Betriebsarten stehen in .env.development (npm run dev) beziehungsweise werden
# von den Skripten `preview` und `bundle` gesetzt. Diese Datei ist nur nötig,
# wenn du davon abweichen willst.

# Adresse der PHP-API.
#   lokal im Schnellmodus:  http://{host}:8888/MealMap/api
#   lokal unter MAMP:       /MealMap/api
#   live:                   /api
NEXT_PUBLIC_API_BASE="/MealMap/api"

# Verzeichnis, in dem die App liegt. Live leer, lokal /MealMap.
NEXT_PUBLIC_BASE_PATH="/MealMap"
