# Abhängigkeiten
/node_modules

# Erzeugte Ordner
# .next  = Zwischenstand von Next.js
# out    = statischer Export
# dist   = fertiges Bündel für Server und lokale Vorschau
/.next/
/out/
/dist/
/.browser-sync

# Umgebungsvariablen
# .env-Dateien sind grundsätzlich ausgeschlossen, weil sie Zugangsdaten
# enthalten können. Zwei Ausnahmen: die Vorlage und die Entwicklungswerte –
# beide enthalten keine Geheimnisse und werden auf jedem Rechner gebraucht.
.env*
!.env.example
!.env.development

# Zugangsdaten der PHP-API – Vorlage liegt als api/config.example.php daneben
/api/config.php

# Von Werkzeugen erzeugt
*.tsbuildinfo
next-env.d.ts

# Betriebssystem
.DS_Store
*.pem

# Protokolle
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
